# ==============================================================================
# prod.tfvars — design target. NEVER APPLIED.
#
# GITIGNORED, for symmetry with demo.tfvars; it holds no real secrets.
#
# Per ADR-0002, this file exists so the production intent behind each value is
# auditable at a glance: the diff between this file and demo.tfvars IS the
# demo/production delta, and that diff is part of what the portfolio
# demonstrates. It is never passed to apply.
# ==============================================================================

# Omitted on purpose — these use their defaults in variables.tf:
#   aws_region      -> "us-east-1"
#   resource_prefix -> "pyrosense"

environment = "prod"

# --- FinOps guardrail (modules/budgets, ADR-0003) -----------------------------

# Sized for a real deployment: continuous telemetry from a deployed sensor
# fleet, permanent S3 retention and production-grade DynamoDB capacity. This is
# a monitoring threshold, not a spend commitment.
budget_limit_usd = 5000

# --- Notification recipients (modules/budgets + modules/alerting, ADR-0014) ---

# Placeholders. In a real deployment these are institutional distribution lists
# owned by their teams, not individual mailboxes: alerts must survive staff
# turnover.
#
# The two maps are the production reason the topics are separate. Operators get
# budget and CloudWatch alarm notifications — platform health. Responders get
# CRITICAL fire alerts carrying device coordinates. A duty desk at Bomberos has
# no business receiving a DLQ-depth alarm, and the platform team should not be
# the path a fire alert travels through.
ops_recipients = {
  "platform-oncall" = "pyrosense-ops@example.org"
}

fire_alert_recipients = {
  "bomberos-duty-desk" = "pyrosense-fire-duty@example.org"
}

# --- Encryption (modules/security, ADR-0010) ----------------------------------

# AWS maximum. Scheduling this key for deletion makes every object in S3, every
# item in DynamoDB and every queued message permanently unreadable. 30 days is
# the widest window available to notice the mistake and cancel it.
kms_deletion_window_days = 30


# --- Data lifecycle (modules/storage, ADR-0013) -------------------------------

# Explicit although it equals the default: this file documents production
# intent. false keeps DynamoDB deletion protection on and S3 force_destroy
# off, so destroy fails on a table or a bucket that holds data. Deleting prod
# data takes two deliberate steps (flip, apply, then destroy), and the root
# variable rejects true for prod at plan time anyway.
allow_data_destruction = false
